{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/docs/:path*",
      "has": [{ "type": "host", "value": "docs.roxy.theali.app" }],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "has": [{ "type": "host", "value": "roxy.theali.app" }],
      "destination": "https://docs.roxy.theali.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "docs.roxy.theali.app" }],
      "destination": "/docs"
    },
    {
      "source": "/install",
      "has": [{ "type": "host", "value": "docs.roxy.theali.app" }],
      "destination": "/docs/install"
    },
    {
      "source": "/:path((?!_next|docs|install|favicon.ico|host-debug).*)",
      "has": [{ "type": "host", "value": "docs.roxy.theali.app" }],
      "destination": "/docs/:path"
    }
  ]
}
